<?xml version="1.0" encoding="utf-8"?>
<!-- 
    ملف البيان (Manifest) لتطبيق "الجمارك الزمنية" (Douane Temporelle)
    يحتوي على تعريف الأنشطة الثلاثة وإعدادات التطبيق العامة.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fsegt.douanetemporelle">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DouaneTemporelle">

        <!-- 1. النشاط الأول: استمارة التسجيل (MainActivity) وهو نقطة الانطلاق الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. النشاط الثاني: ماسح المفارقات الزمنية (VerificationActivity) -->
        <activity
            android:name=".VerificationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 3. النشاط الثالث: الحكم النهائي وقرار العبور (ResultActivity) -->
        <activity
            android:name=".ResultActivity"
            android:exported="false" />

    </application>

</manifest>
