<?xml version="1.0" encoding="utf-8"?>
<!-- 
    خلفية مخصصة لتصميم التذكرة أو جواز السفر الزمني (Passport / Ticket)
    تمنح النشاط الثاني مظهراً شبيهاً ببطاقة العبور الدبلوماسية
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F8FAFC" />
    <corners android:radius="16dp" />
    <stroke
        android:width="2dp"
        android:color="#0284C7" />
    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</shape>
