<?xml version="1.0" encoding="utf-8"?>
<!--
    النشاط 2 : ماسح المفارقات والتذكرة الزمنية (VerificationActivity)
    
    الشرط الإجباري من نص الامتحان:
    - البنية الرئيسية الجذرية: LinearLayout أفقي (orientation="horizontal").
    - على اليسار: صورة (ImageView) بوزن 0.3 (layout_weight="0.3").
    - على اليمين: RelativeLayout بوزن 0.7 (layout_weight="0.7") لعرض النصوص والأزرار.
    - المظهر العام: يشبه "تذكرة سفر" أو "جواز سفر زمني".
    - جميع المعرفات (IDs) تنتهي بالحروف الأولى للطالب (_nj).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_racine_verification_nj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- 1. القسم الأيسر: صورة المسافر / الهوية الزمنية بوزن 0.3 إجبارياً -->
    <LinearLayout
        android:id="@+id/ll_conteneur_image_nj"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/passport_ticket_bg"
        android:layout_marginEnd="8dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_photo_identite_nj"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/ic_time_traveler"
            android:contentDescription="@string/desc_photo_voyageur"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tv_tampon_douane_nj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSPORT\nTEMPOREL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0284C7"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- 2. القسم الأيمن: RelativeLayout بوزن 0.7 إجبارياً للنصوص والأزرار -->
    <RelativeLayout
        android:id="@+id/rl_details_passeport_nj"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@drawable/passport_ticket_bg"
        android:padding="14dp">

        <!-- ترويسة الجواز الزمني -->
        <TextView
            android:id="@+id/tv_entete_passeport_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/passport_header"
            android:textColor="#0369A1"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_alignParentTop="true"
            android:layout_marginBottom="12dp" />

        <!-- تفاصيل المسافر: الاسم -->
        <TextView
            android:id="@+id/tv_resume_nom_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_entete_passeport_nj"
            android:text="Voyageur : -"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- تفاصيل المسافر: العمر الزمني المحسوب -->
        <TextView
            android:id="@+id/tv_resume_age_temporel_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_resume_nom_nj"
            android:text="Âge temporel : -"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- تفاصيل المسافر: الدافع المصرح به -->
        <TextView
            android:id="@+id/tv_resume_motif_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_resume_age_temporel_nj"
            android:text="Motif : -"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- تنبيه خطر المفارقة الزمنية (يظهر فقط عند تحقق الشرط) -->
        <TextView
            android:id="@+id/tv_alerte_paradoxe_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_resume_motif_nj"
            android:text="@string/alert_paradox_detected"
            android:textColor="#B91C1C"
            android:background="#FEE2E2"
            android:padding="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <!-- زر الموافقة على السفر عبر الزمن -->
        <Button
            android:id="@+id/btn_approuver_saut_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_saut_nj"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_approuver_saut"
            android:background="@drawable/btn_gradient_success"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- زر الرفض بسبب خطر المفارقة الزمنية -->
        <Button
            android:id="@+id/btn_refuser_saut_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/btn_refuser_saut"
            android:background="@drawable/btn_gradient_danger"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

</LinearLayout>
